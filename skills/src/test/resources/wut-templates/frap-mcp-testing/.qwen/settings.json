{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@0.20.3",
        "--executable-path",
        "/usr/bin/google-chrome",
        "--isolated"
      ]
    },
    "frap-http": {
      "httpUrl": "http://localhost:8765/mcp",
      "timeput": 30000,
      "trust": true
    }
  },
  "$version": 4,
  "mcp": {
    "allowed": [
      "chrome-devtools",
      "frap-http"
    ],
    "exscluded": []
  }
}
