{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "frap-http": {
      "httpUrl": "http://localhost:8765/mcp",
      "timeput": 30000,
      "trust": true
    }
  },
  "$version": 4,
  "mcp": {
    "allowed": [
      "chrome-devtools",
      "frap-http"
    ],
    "exscluded": []
  }
}
