{
  "env": {
    "OPENAI_API_KEY": "$OPENAI_API_KEY"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "gpt-5-nano",
        "name": "GPT-5 Nano",
        "baseUrl": "https://api.openai.com/v1",
        "envKey": "OPENAI_API_KEY",
        "generationConfig": {
          "timeout": 240000,
          "maxRetries": 0,
          "contextWindowSize": 400000,
          "samplingParams": {
            "max_completion_tokens": 8192
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "gpt-5-nano"
  },
  "$version": 3
}
