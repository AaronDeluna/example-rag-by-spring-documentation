{
  "$version": 4,
  "model": {
    "name": "gpt-5-nano"
  },
  "env": {
    "OLLAMA_API_KEY": "ollama",
    "OPENAI_API_KEY": "$OPENAI_API_KEY"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "gpt-5-nano",
        "name": "GPT-5 Nano",
        "baseUrl": "https://api.openai.com/v1",
        "envKey": "OPENAI_API_KEY",
        "generationConfig": {
          "timeout": 240000,
          "maxRetries": 0,
          "contextWindowSize": 400000,
          "samplingParams": {
            "max_completion_tokens": 8192
          }
        }
      },
      {
        "id": "qwen3.5:9b",
        "name": "qwen3.5:9b",
        "baseUrl": "http://localhost:11434/v1",
        "envKey": "OLLAMA_API_KEY",
        "generationConfig": {
          "modalities": {
            "image": false,
            "video": false,
            "audio": false
          },
          "extra_body": {
            "enable_thinking": false
          }
        }
      },
      {
        "id": "qwen3:8b",
        "name": "qwen3:8b",
        "baseUrl": "http://localhost:11434/v1",
        "envKey": "OLLAMA_API_KEY",
        "generationConfig": {
          "modalities": {
            "image": false,
            "video": false,
            "audio": false
          },
          "extra_body": {
            "enable_thinking": false
          }
        }
      },
      {
        "id": "carstenuhlig/omnicoder-9b:q4_k_m",
        "name": "carstenuhlig/omnicoder-9b:q4_k_m",
        "baseUrl": "http://localhost:11434/v1",
        "envKey": "OLLAMA_API_KEY",
        "generationConfig": {
          "timeout": 240000,
          "maxRetries": 0,
          "modalities": {
            "image": false,
            "video": false,
            "audio": false
          },
          "extra_body": {
            "enable_thinking": false
          }
        }
      },
      {
        "id": "qwen2.5-coder:7b",
        "name": "qwen2.5-coder:7b",
        "baseUrl": "http://localhost:11434/v1",
        "envKey": "OLLAMA_API_KEY",
        "generationConfig": {
          "timeout": 240000,
          "maxRetries": 0,
          "modalities": {
            "image": false,
            "video": false,
            "audio": false
          },
          "extra_body": {
            "enable_thinking": false
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "general": {
    "language": "en",
    "outputLanguage": "русский"
  },
  "mcpServers": {
    "jar-unpacker": {
      "command": "java",
      "args": [
        "-jar",
        "${workspaceFolder}/mcp-server-jar-unpacker/target/mcp-server-jar-unpacker-1.0-SNAPSHOT.jar"
      ],
      "cwd": "${workspaceFolder}/mcp-server-jar-unpacker"
    }
  },
  "mcp": {
    "allowed": [
      "jar-unpacker"
    ],
    "excluded": []
  },
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(java *)",
      "Bash(sleep *)"
    ]
  }
}
